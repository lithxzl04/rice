{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/lith.png",
        "width": 28,
        "height": 14,
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": " ▸ ",
        "color": { "keys": "red", "title": "red", "separator": "90" }
    },
    "modules": [
        { "type": "title", "format": "{user-name-colored}\u001b[90m@\u001b[0m{host-name-colored}" },
        { "type": "custom", "format": "\u001b[90m──────────────────────────────" },
        { "type": "os",       "key": "os    " },
        { "type": "kernel",   "key": "krnl  " },
        { "type": "wm",       "key": "wm    " },
        { "type": "shell",    "key": "sh    " },
        { "type": "terminal", "key": "term  " },
        { "type": "packages", "key": "pkgs  ", "disabled": ["flatpak"] },
        { "type": "custom", "format": "\u001b[90m──────────────────────────────" },
        { "type": "cpu",    "key": "cpu   ", "format": "{name}" },
        { "type": "gpu",    "key": "gpu   ", "format": "{name}" },
        { "type": "memory", "key": "mem   ", "format": "{used} / {total}" },
        { "type": "disk",   "key": "disk  ", "folders": "/", "format": "{size-used} / {size-total}" },
        { "type": "uptime", "key": "up    " },
        { "type": "custom", "format": "\u001b[90m──────────────────────────────" },
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
